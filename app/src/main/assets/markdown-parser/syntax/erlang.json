{
  "name": "erlang",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "%.*" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:#[0-9a-zA-Z]+)?\\b" },
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" }
      ]
    },
    {
      "name": "atom",
      "patterns": [
        { "regex": "'[^']*'" },
        { "regex": "\\b[a-z][\\w@]*\\b" }
      ]
    },
    {
      "name": "variable",
      "patterns": [
        { "regex": "\\b[A-Z_][\\w]*\\b" },
        { "regex": "\\b_[\\w]*\\b" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:after|and|andalso|band|begin|bnot|bor|bsl|bsr|bxor|case|catch|cond|div|end|fun|if|let|not|of|or|orelse|receive|rem|try|when|xor)\\b" }
      ]
    },
    {
      "name": "builtin",
      "patterns": [
        { "regex": "\\b(?:module|export|import|compile|define|record|include|include_lib|behaviour)\\b" }
      ]
    }
  ]
}