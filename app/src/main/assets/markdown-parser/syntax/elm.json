{
  "name": "elm",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "--[^\\n]*" },
        { "regex": "{-[\\s\\S]*?-}" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true },
        { "regex": "\"\"\"[\\s\\S]*?\"\"\"", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" }
      ]
    },
    {
      "name": "module",
      "patterns": [
        { "regex": "\\b[A-Z][\\w]*(?:\\.[A-Z][\\w]*)*\\b" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:alias|as|case|else|if|in|import|let|module|of|port|then|type|where)\\b" }
      ]
    },
    {
      "name": "builtin",
      "patterns": [
        { "regex": "\\b(?:Bool|Int|Float|String|Char|List|Maybe|Result|Program|Cmd|Sub|Html)\\b" }
      ]
    },
    {
      "name": "operator",
      "patterns": [
        { "regex": "[+\\-*/%<>=!&|^:]+|->|\\|>|<\\||::|//" }
      ]
    }
  ]
}