{
  "name": "qml",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "//[^\\n]*" },
        { "regex": "/\\*[\\s\\S]*?\\*/", "greedy": true }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:import|property|readonly|signal|function|on|enum|id|parent|anchor|state|when|true|false)\\b" }
      ]
    },
    {
      "name": "qmltype",
      "patterns": [
        { "regex": "\\b(?:Item|Rectangle|Text|Image|Button|Window|ApplicationWindow|MouseArea|ListView|GridView|Column|Row|Grid|Flow|Repeater|Loader|Connections|Binding|Timer|FontLoader|Component)\\b" }
      ]
    },
    {
      "name": "property",
      "patterns": [
        { "regex": "\\b[a-z]+[A-Z]\\w*\\s*:" }
      ]
    }
  ]
}