{
  "name": "cfml",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "<!---[\\s\\S]*?--->" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true },
        { "regex": "'(?:[^'\\\\]|\\\\.)*'", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?\\b" }
      ]
    },
    {
