{
  "name": "edn",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": ";.*" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[+-]?[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?[M]?\\b" },
        { "regex": "\\b0[xX][0-9a-fA-F]+\\b" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": ":[\\w#\\.\\-]+" }
      ]
    },
    {
      "name": "boolean",
      "patterns": [
        { "regex": "\\b(?:true|false)\\b" }
      ]
    },
    {
      "name": "nil",
      "patterns": [
        { "regex": "\\bnil\\b" }
      ]
    },
    {
      "name": "tag",
      "patterns": [
        { "regex": "#[\\w]+" }
      ]
    }
  ]
}