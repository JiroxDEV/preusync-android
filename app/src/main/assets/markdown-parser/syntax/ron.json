{
  "name": "ron",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "//[^\\n]*" },
        { "regex": "/\\*[\\s\\S]*?\\*/", "greedy": true }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[+-]?[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" },
        { "regex": "\\b0[xX][0-9a-fA-F]+\\b" }
      ]
    },
    {
      "name": "boolean",
      "patterns": [
        { "regex": "\\b(?:true|false)\\b" }
      ]
    },
    {
      "name": "option",
      "patterns": [
        { "regex": "\\b(?:Some|None)\\b" }
      ]
    },
    {
      "name": "struct",
      "patterns": [
        { "regex": "\\b[a-zA-Z_]\\w*\\s*\\(" }
      ]
    },
    {
      "name": "punctuation",
      "patterns": [
        { "regex": "[{}\\[\\]():,]+" }
      ]
    }
  ]
}