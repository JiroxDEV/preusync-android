{
  "name": "wsdl",
  "extend": "xml",
  "tokens": [
    {
      "name": "element",
      "patterns": [
        { "regex": "</?(?:definitions|types|message|portType|operation|input|output|fault|binding|service|port|documentation)\\b[^>]*>", "flags": "CASE_INSENSITIVE" }
      ]
    },
    {
      "name": "attribute",
      "patterns": [
        { "regex": "\\b(?:name|type|message|element|style|transport|soapAction|namespace|schemaLocation|location)\\b", "flags": "CASE_INSENSITIVE" }
      ]
    }
  ]
}