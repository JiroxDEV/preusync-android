{
  "name": "ocaml",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "\\(\\*[\\s\\S]*?\\*\\)" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true },
        { "regex": "\\{[a-z_]*\\|", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" },
        { "regex": "\\b0[xX][0-9a-fA-F]+\\b" },
        { "regex": "\\b0[oO][0-7]+\\b" },
        { "regex": "\\b0[bB][01]+\\b" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:and|as|assert|asr|begin|class|constraint|do|done|downto|else|end|exception|external|false|for|fun|function|functor|if|in|include|inherit|initializer|land|lazy|let|lor|lsl|lsr|lxor|match|method|mod|module|mutable|new|nonrec|object|of|open|or|private|rec|sig|struct|then|to|true|try|type|val|virtual|when|while|with)\\b" }
      ]
    },
    {
      "name": "builtin",
      "patterns": [
        { "regex": "\\b(?:int|float|char|string|bool|unit|list|array|option|ref|exn|format)\\b" }
      ]
    },
    {
      "name": "operator",
      "patterns": [
        { "regex": "[+\\-*/%<>=!&|^@:]+|->|<-|::|:>|;;" }
      ]
    }
  ]
}