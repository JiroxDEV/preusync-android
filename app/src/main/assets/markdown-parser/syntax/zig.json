    },
    {
      "name": "builtin",
      "patterns": [
        { "regex": "\\b(?:i1|i8|i16|i32|i64|i128|u1|u8|u16|u32|u64|u128|f16|f32|f64|f80|f128|bool|void|noreturn|type|anyerror|c_short|c_ushort|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_longdouble|comptime_int|comptime_float)\\b" }
      ]
    }
  ]
}