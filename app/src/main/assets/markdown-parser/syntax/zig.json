        { "regex": "\\b0[oO][0-7]+\\b" },
        { "regex": "\\b0[bB][01]+\\b" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:align|allowzero|and|anyframe|anytype|asm|async|await|break|callconv|catch|comptime|const|continue|defer|else|enum|errdefer|error|export|extern|false|fn|for|if|inline|linksection|noalias|nosuspend|null|or|orelse|packed|pub|resume|return|struct|suspend|switch|test|threadlocal|true|try|union|unreachable|usingnamespace|var|volatile|while)\\b" }
