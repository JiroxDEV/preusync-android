{
  "name": "rdf-xml",
  "extend": "xml",
  "tokens": [
    {
      "name": "element",
      "patterns": [
        { "regex": "</?(?:rdf(?:\\:RDF)?|rdfs(?:\\:Class)?|owl(?:\\:Class)?|dc(?:\\:title|\\:creator)?|foaf(?:\\:Person)?|skos(?:\\:Concept)?)>", "flags": "CASE_INSENSITIVE" }
      ]
    },
    {
      "name": "attribute",
      "patterns": [
        { "regex": "\\brdf(?:\\:about|\\:resource|\\:ID|\\:nodeID|\\:datatype)\\b", "flags": "CASE_INSENSITIVE" }
      ]
    }
  ]
}