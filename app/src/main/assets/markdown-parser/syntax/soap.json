{
  "name": "soap",
  "extend": "xml",
  "tokens": [
    {
      "name": "element",
      "patterns": [
        { "regex": "</?(?:soap:Envelope|soap:Header|soap:Body|soap:Fault|wsdl:definitions|wsdl:types|wsdl:message|wsdl:portType|wsdl:binding|wsdl:service|wsdl:port|wsdl:operation|wsdl:input|wsdl:output|wsdl:fault|soap:address)\\b[^>]*>", "flags": "CASE_INSENSITIVE" }
      ]
    },
    {
      "name": "attribute",
      "patterns": [
        { "regex": "\\b(?:soap:encodingStyle|xmlns:soap|xmlns:wsdl|targetNamespace|xmlns:xsd|xmlns:xsi)\\b", "flags": "CASE_INSENSITIVE" }
      ]
    }
  ]
}