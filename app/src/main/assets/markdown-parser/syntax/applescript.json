{
  "name": "applescript",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "--[^\\n]*" },
        { "regex": "#[^\\n]*" },
        { "regex": "\\(\\*[\\s\\S]*?\\*\\)" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:about|above|against|and|apart|around|as|at|back|before|begin|behind|below|beneath|beside|between|but|by|considering|contain|contains|continue|copy|div|does|eighth|else|end|equal|error|every|exit|false|fifth|first|for|fourth|from|front|get|global|if|ignoring|in|into|is|it|its|last|launch|local|me|middle|mod|my|ninth|not|of|on|onto|or|out|over|preposition|prop|property|put|repeat|return|second|set|seventh|since|sixth|some|tell|tenth|that|the|then|third|through|thru|to|true|try|until|where|while|whose|with|without)\\b", "flags": "CASE_INSENSITIVE" }
      ]
    },
    {
      "name": "command",
      "patterns": [
        { "regex": "\\b(?:display dialog|display alert|choose file|choose folder|choose from list|say|beep|delay|do shell script)\\b", "flags": "CASE_INSENSITIVE" }
      ]
    }
  ]
}