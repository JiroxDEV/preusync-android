{
  "name": "julia",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "#[^\\n]*" },
        { "regex": "#=[\\s\\S]*?=#" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true },
        { "regex": "\"\"\"[\\s\\S]*?\"\"\"", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eEf][+-]?[0-9]+)?\\b" },
        { "regex": "\\b0[xX][0-9a-fA-F]+\\b" },
        { "regex": "\\b0[oO][0-7]+\\b" },
        { "regex": "\\b0[bB][01]+\\b" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:baremodule|begin|break|catch|const|continue|do|else|elseif|end|export|false|finally|for|function|global|if|import|in|isa|let|local|macro|module|outer|quote|return|struct|true|try|using|while|where)\\b" }
      ]
    },
    {
      "name": "builtin",
      "patterns": [
        { "regex": "\\b(?:Int8|Int16|Int32|Int64|Int128|UInt8|UInt16|UInt32|UInt64|UInt128|Float16|Float32|Float64|ComplexF16|ComplexF32|ComplexF64|Char|String|Bool|Symbol|Array|Vector|Matrix|Dict|Set|Tuple|NamedTuple|Range|StepRange|UnitRange)\\b" }
      ]
    },
    {
      "name": "operator",
      "patterns": [
        { "regex": "[+\\-*/%<>=!&|^~@:]+|->|<-|\\.\\.|\\.\\.\\." }
      ]
    }
  ]
}