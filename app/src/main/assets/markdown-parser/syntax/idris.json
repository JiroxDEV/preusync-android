{
  "name": "idris",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "--[^\\n]*" },
        { "regex": "{-[\\s\\S]*?-}" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" },
        { "regex": "\\b0[xX][0-9a-fA-F]+\\b" },
        { "regex": "\\b0[oO][0-7]+\\b" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:data|module|where|public|abstract|private|total|partial|covering|record|constructor|class|instance|with|do|let|in|case|of|if|then|else|rewrite|using|namespace|import|as|infix|infixl|infixr|proof|search|auto|default|impossible)\\b" }
      ]
    },
    {
      "name": "builtin",
      "patterns": [
        { "regex": "\\b(?:Type|Nat|Int|Integer|Float|Double|Char|String|Bool|List|Stream|Vect|Fin|Maybe|Either|IO|Provable|Dec|Eq|Ord|Show|Semigroup|Monoid|Functor|Applicative|Monad)\\b" }
      ]
    },
    {
      "name": "operator",
      "patterns": [
        { "regex": "[+\\-*/%<>=!&|^@:]+|->|<-|::|=>|\\\\|\\|>|\\$|\\.\\.|\\.\\.\\." }
      ]
    }
  ]
}