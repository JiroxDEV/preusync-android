{
  "name": "raku",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "#`(\\(|\\{|\\[|<|«)[\\s\\S]*?[)\\}\\]]>»" },
        { "regex": "#.*" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true },
        { "regex": "'(?:[^'\\\\]|\\\\.)*'", "greedy": true },
        { "regex": "q[qx]?\\{[^}]*\\}", "greedy": true },
        { "regex": "q[qx]?\\([^\\)]*\\)", "greedy": true },
        { "regex": "q[qx]?\\[[^\\]]*\\]", "greedy": true },
        { "regex": "q[qx]?\\/[^\\/]*\\/", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" },
        { "regex": "\\b0[xX][0-9a-fA-F]+\\b" },
        { "regex": "\\b0[bB][01]+\\b" },
        { "regex": "\\b0[oO][0-7]+\\b" },
        { "regex": "\\b0[dD][0-9]+\\b" }
      ]
    },
    {
      "name": "variable",
      "patterns": [
        { "regex": "[\\$@%&]\\:?[\\w\\-]+" },
        { "regex": "[\\$@%&]\\<[^>]+\\>" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:if|else|elsif|unless|with|without|when|while|until|loop|for|given|default|repeat|do|done|return|sub|method|has|is|of|where|augment|supersede|proto|multi|only|trait|handles|trusts|does|but|unit|module|class|grammar|rule|token|regex|our|my|state|anon|constant|temp|let|CATCH|CONTROL|NEXT|LAST|redo|KEEP|UNDO)\\b" }
      ]
    },
    {
      "name": "operator",
      "patterns": [
        { "regex": "\\+\\+|--|[+\\-*/%<>=!&|^~?.\\\\|]+|=>|->|\\.\\.\\.|\\?\\?|::" }
      ]
    }
  ]
}