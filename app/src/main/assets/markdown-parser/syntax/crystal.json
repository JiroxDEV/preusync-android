{
  "name": "crystal",
  "extend": "clike",
  "tokens": [
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:abstract|alias|as|asm|begin|break|case|class|def|do|else|elsif|end|ensure|enum|extend|false|for|fun|if|in|include|instance_sizeof|is_a?|lib|macro|module|next|nil|of|offsetof|out|pointerof|private|protected|require|rescue|return|select|self|sizeof|struct|super|then|true|type|typeof|undef|union|unless|until|when|while|with|yield)\\b" }
      ]
    },
    {
      "name": "builtin",
      "patterns": [
        { "regex": "\\b(?:Int8|Int16|Int32|Int64|UInt8|UInt16|UInt32|UInt64|Float32|Float64|Char|String|Bool|Object|Nil|Array|Hash|Set|Range)\\b" }
      ]
    },
    {
      "name": "macro",
      "patterns": [
        { "regex": "\\b(?:{%\\s*if|{%\\s*elsif|{%\\s*else|{%\\s*end|{%\\s*for|{%\\s*begin|{%\\s*end|{{|}})\\b" }
      ]
    }
  ]
}