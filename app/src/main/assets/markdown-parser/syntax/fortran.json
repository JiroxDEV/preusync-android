{
  "name": "fortran",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "![^\\n]*" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true },
        { "regex": "'(?:[^'\\\\]|\\\\.)*'", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]*)?(?:[eEdD][+-]?[0-9]+)?\\b" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:abstract|all|allocatable|assign|associate|asynchronous|backspace|bind|block|call|case|class|close|common|complex|contains|continue|cycle|data|deallocate|default|deferred|dimension|do|double|elemental|else|elseif|elsewhere|end|endfile|endif|entry|enum|enumerator|equivalence|error|exit|extends|external|final|flush|forall|format|function|generic|go|goto|if|implicit|import|include|inquire|integer|interface|intrinsic|logical|module|namelist|non_overridable|nopass|nullify|only|open|operator|optional|parameter|pass|pause|pointer|precision|print|private|procedure|program|protected|public|pure|read|real|recursive|result|return|rewind|save|select|sequence|stop|submodule|subroutine|target|then|type|use|value|volatile|wait|where|while|write)\\b", "flags": "CASE_INSENSITIVE" }
      ]
    },
    {
      "name": "operator",
      "patterns": [
        { "regex": "[+\\-*/<>=]+|[.]\\w+[.]" }
      ]
    }
  ]
}