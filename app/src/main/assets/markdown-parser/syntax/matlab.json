{
  "name": "matlab",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "%\\{[\\s\\S]*?%\\}" },
        { "regex": "%.*" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "'(?:[^'\\\\]|\\\\.)*'", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?[ijk]?\\b" },
        { "regex": "\\b0[xX][0-9a-fA-F]+\\b" },
        { "regex": "\\b0[oO][0-7]+\\b" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:break|case|catch|classdef|continue|else|elseif|end|for|function|global|if|otherwise|parfor|persistent|return|spmd|switch|try|while)\\b" }
      ]
    },
    {
      "name": "builtin",
      "patterns": [
        { "regex": "\\b(?:abs|acos|asin|atan|cos|exp|eye|false|inf|Inf|i|j|length|log|log10|log2|NaN|nan|ones|pi|rand|randi|randn|real|sin|size|sqrt|tan|true|zeros)\\b" }
      ]
    },
    {
      "name": "operator",
      "patterns": [
        { "regex": "[+\\-*/\\\\^<>=~@:]+|\\\\" }
      ]
    }
  ]
}