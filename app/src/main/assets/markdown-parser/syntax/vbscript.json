{
  "name": "vbscript",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "'[^\\n]*" },
        { "regex": "Rem\\s.*", "flags": "CASE_INSENSITIVE" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:Call|Class|Const|Dim|Do|Each|Else|Empty|End|Eqv|Erase|Error|Exit|Explicit|False|For|Function|Get|GoTo|If|Imp|In|Is|Let|Loop|Mod|New|Next|Not|Nothing|Null|On|Option|Or|Preserve|Private|Public|Randomize|ReDim|Rem|Resume|Return|Select|Set|Step|Stop|Sub|Then|To|True|Until|Wend|While|With|Xor)\\b", "flags": "CASE_INSENSITIVE" }
      ]
    }
  ]
}