{
  "name": "ada",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "--.*" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" },
        { "regex": "\\b[0-9]+#[0-9a-fA-F]+(?:\\.[0-9a-fA-F]+)?#(?:[eE][+-]?[0-9]+)?\\b" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:abort|abs|abstract|accept|access|aliased|all|and|array|at|begin|body|case|constant|declare|delay|delta|digits|do|else|elsif|end|entry|exception|exit|for|function|generic|goto|if|in|interface|is|limited|loop|mod|new|not|null|of|or|others|out|overriding|package|pragma|private|procedure|protected|raise|range|record|rem|renames|requeue|return|reverse|select|separate|some|subtype|synchronized|tagged|task|terminate|then|type|until|use|when|while|with|xor)\\b" }
      ]
    },
    {
      "name": "builtin",
      "patterns": [
        { "regex": "\\b(?:Ada\\.Text_IO|Ada\\.Integer_Text_IO|Ada\\.Float_Text_IO|Standard|Boolean|Character|Wide_Character|Float|Integer|Natural|Positive|String|Wide_String|Duration)\\b" }
      ]
    },
    {
      "name": "attribute",
      "patterns": [
        { "regex": "'[A-Za-z]\\w*\\b" }
      ]
    }
  ]
}