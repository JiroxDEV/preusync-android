{
  "name": "standardml",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "\\(\\*[\\s\\S]*?\\*\\)" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" },
        { "regex": "\\b0[xX][0-9a-fA-F]+\\b" },
        { "regex": "\\b0[wW][0-9a-fA-F]+\\b" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:abstype|and|andalso|as|case|datatype|do|else|end|exception|fn|fun|functor|handle|if|in|infix|infixr|let|local|nonfix|of|op|open|orelse|raise|rec|sharing|sig|signature|struct|structure|then|type|val|while|with|withtype)\\b" }
      ]
    },
    {
      "name": "builtin",
      "patterns": [
        { "regex": "\\b(?:bool|int|real|string|char|list|option|unit|ref|array|vector|exn|order|true|false|nil|SOME|NONE)\\b" }
      ]
    }
  ]
}