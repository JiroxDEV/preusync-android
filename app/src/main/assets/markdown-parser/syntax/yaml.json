{
  "name": "yaml",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "#.*" }
      ]
    },
    {
      "name": "key",
      "patterns": [
        { "regex": "^[a-zA-Z_][\\w\\s]*:" },
        { "regex": "^\\s+[a-zA-Z_][\\w\\s]*:" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true },
        { "regex": "'(?:[^'\\\\]|\\\\.)*'", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" }
      ]
    },
    {
      "name": "boolean",
      "patterns": [
        { "regex": "\\b(?:true|false|yes|no|on|off)\\b", "flags": "CASE_INSENSITIVE" }
      ]
    },
    {
      "name": "null",
      "patterns": [
        { "regex": "\\b(?:null|~)\\b", "flags": "CASE_INSENSITIVE" }
      ]
    },
    {
      "name": "anchor",
      "patterns": [
        { "regex": "&\\w+" },
        { "regex": "\\*\\w+" }
      ]
    },
    {
      "name": "directive",
      "patterns": [
        { "regex": "%YAML\\s+[1-9]\\.[0-9]" },
        { "regex": "%TAG\\s+\\S+" }
      ]
    }
  ]
}