{
  "name": "powershell",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "<#[\\s\\S]*?#>" },
        { "regex": "#.*" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "'(?:[^'\\\\]|\\\\.)*'", "greedy": true },
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true },
        { "regex": "@\"[\\s\\S]*?\"@", "greedy": true },
        { "regex": "@'[\\s\\S]*?'@", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?[kKmMgGtTpP]?\\b" },
        { "regex": "\\b0[xX][0-9a-fA-F]+\\b" }
      ]
    },
    {
      "name": "variable",
      "patterns": [
        { "regex": "\\$[A-Za-z_]\\w*" },
        { "regex": "\\$\\{[^}]+\\}" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:begin|break|catch|class|continue|data|define|do|dynamicparam|else|elseif|end|enum|exit|filter|finally|for|foreach|from|function|hidden|if|in|interface|param|process|return|static|switch|throw|trap|try|until|using|var|while|workflow)\\b" }
      ]
    },
    {
      "name": "cmdlet",
      "patterns": [
        { "regex": "\\b[A-Za-z]+-[A-Za-z]+\\b" }
      ]
    },
    {
      "name": "operator",
      "patterns": [
        { "regex": "-[a-z]+|\\b(?:eq|ne|gt|ge|lt|le|like|notlike|match|notmatch|replace|contains|notcontains|in|notin|is|isnot|as|split|join|and|or|not|xor|band|bor|bxor|bnot|shl|shr)\\b", "flags": "CASE_INSENSITIVE" }
      ]
    }
  ]
}