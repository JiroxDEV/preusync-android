{
  "name": "thrift",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "//[^\\n]*" },
        { "regex": "#[^\\n]*" },
        { "regex": "/\\*[\\s\\S]*?\\*/", "greedy": true }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true },
        { "regex": "'(?:[^'\\\\]|\\\\.)*'", "greedy": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b[0-9]+(?:\\.[0-9]+)?\\b" }
      ]
    },
    {
      "name": "keyword",
      "patterns": [
        { "regex": "\\b(?:include|namespace|cpp_include|php_namespace|py_module|perl_package|ruby_namespace|smalltalk_category|java_package|cocoa_prefix|xsd_namespace|csharp_namespace|delphi_namespace|const|typedef|enum|struct|union|exception|service|extends|throws|oneway|void|bool|byte|i16|i32|i64|double|string|binary|map|set|list|required|optional)\\b" }
      ]
    }
  ]
}