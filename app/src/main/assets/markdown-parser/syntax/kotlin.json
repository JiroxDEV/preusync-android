{
  "name": "kotlin",
  "extend": "clike",
  "tokens": [
    {
      "name": "keyword",
      "patterns": [
        { "regex": "(^|[^.])\\b(?:abstract|actual|annotation|as|break|by|catch|class|companion|const|constructor|continue|crossinline|data|do|dynamic|else|enum|expect|external|final|finally|for|fun|get|if|import|in|infix|init|inline|inner|interface|internal|is|lateinit|noinline|null|object|open|operator|out|override|package|private|protected|public|reified|return|sealed|set|super|suspend|tailrec|this|throw|to|try|typealias|val|var|vararg|when|where|while)\\b", "lookbehind": true }
      ]
    },
    {
      "name": "function",
      "patterns": [
        { "regex": "\\w+(?=\\s*\\()" },
        { "regex": "(\\.)\\w+(?=\\s*\\{)", "lookbehind": true }
      ]
    },
    {
      "name": "number",
      "patterns": [
        { "regex": "\\b(?:0[xX][\\da-fA-F]+(?:_[\\da-fA-F]+)*|0[bB][01]+(?:_[01]+)*|\\d+(?:_\\d+)*(?:\\.\\d+(?:_\\d+)*)?(?:[eE][+-]?\\d+(?:_\\d+)*)?[fFL]?)\\b" }
      ]
    },
    {
      "name": "operator",
      "patterns": [
        { "regex": "\\+[+=]?|-[-=>]?|==?=?|!(?:!|==?)?|[\\/*%<>]=?|[?:]:?|\\.\\.|&&|\\|\\||\\b(?:and|inv|or|shl|shr|ushr|xor)\\b" }
      ]
    }
  ],
  "insertBefore": {
    "string": [
      {
        "name": "raw-string",
        "patterns": [
          { "regex": "(\"\"\"|''')[\\s\\S]*?\\1", "global": true }
        ]
      }
    ],
    "keyword": [
      {
        "name": "annotation",
        "patterns": [
          { "regex": "\\B@(?:\\w+:)?(?:[A-Z]\\w*|\\[[^\\]]+\\])", "inside": {
            "tokens": [
              { "name": "builtin", "patterns": [ { "regex": ".+" } ] }
            ]
          }}
        ]
      }
    ],
    "function": [
      {
        "name": "label",
        "patterns": [
          { "regex": "\\w+@|@\\w+", "inside": {
            "tokens": [
              { "name": "symbol", "patterns": [ { "regex": ".+" } ] }
            ]
          }}
        ]
      }
    ]
  }
}