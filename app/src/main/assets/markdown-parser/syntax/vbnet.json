{
  "name": "vbnet",
  "tokens": [
    {
      "name": "comment",
      "patterns": [
        { "regex": "'[^\\n]*" },
        { "regex": "REM\\s.*", "flags": "CASE_INSENSITIVE" }
      ]
    },
    {
      "name": "string",
      "patterns": [
        { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "greedy": true }
      ]
    },
    {
