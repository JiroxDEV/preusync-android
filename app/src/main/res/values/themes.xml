<resources>
    <!--Tema con colores estáticos (tus colores definidos en colors.xml)-->
    <style name="Theme.PreuSync.Static" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorControlNormal">@color/colorControlNormal</item>
        <item name="colorControlHighlight">@color/colorControlHighlight</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorControlNormal</item>
        <item name="colorSurface">@color/colorBackground</item>
        <item name="colorSurfaceVariant">@color/colorBackgroundCard</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorOnSecondary">?attr/colorText</item>
        <item name="colorOnSurface">@color/colorText</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@android:color/white</item>
        <item name="colorExito">@color/colorExito</item>
        <item name="colorWarning">@color/colorWarning</item>
        <item name="colorHorarioPrincipal">@color/colorHorarioPrincipal</item>
        <item name="colorBackground">@color/colorBackground</item>
        <item name="colorBackgroundCard">@color/colorBackgroundCard</item>
        <item name="colorText">@color/colorText</item>
        <item name="colorTextHint">@color/colorTextHint</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PreuSync.MaterialAlertDialog</item>
        <item name="materialButtonStyle">@style/Widget.PreuSync.Button.Global</item>
        <item name="materialCardViewStyle">@style/Widget.PreuSync.CardView</item>
    </style>
    <!--Tema con colores dinámicos (Material You) - solo Android 12+-->
    <style name="Theme.PreuSync.Dynamic" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="colorPrimary">@android:color/system_accent1_200</item>
        <item name="colorPrimaryDark">@android:color/system_accent1_300</item>
        <item name="colorPrimaryVariant">@android:color/system_accent2_800</item>
        <item name="colorAccent">@android:color/system_accent1_500</item>
        <item name="colorControlNormal">@android:color/system_accent2_50</item>
        <item name="colorControlHighlight">@android:color/system_accent1_100</item>
        <item name="colorSecondary">@android:color/system_accent1_300</item>
        <item name="colorSecondaryVariant">@android:color/system_accent2_300</item>
        <item name="colorSurface">@android:color/system_neutral1_900</item>
        <item name="colorSurfaceVariant">@android:color/system_neutral2_800</item>
        <item name="colorOnPrimary">@color/colorText</item>
        <item name="colorOnSecondary">@color/colorText</item>
        <item name="colorOnSurface">?attr/colorText</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorText</item>
        <item name="colorExito">?colorPrimaryContainer</item>
        <item name="colorWarning">?colorTertiaryContainer</item>
        <item name="colorHorarioPrincipal">@android:color/system_accent3_700</item>
        <item name="colorHorarioAsignatura">@android:color/system_accent3_700</item>
        <item name="colorHorarioLibre">@android:color/system_neutral2_800</item>
        <item name="colorHorarioResaltadoPrincipal">@android:color/system_accent1_200</item>
        <item name="colorHorarioResaltadoSecundario">@android:color/system_accent2_400</item>
        <item name="colorBackground">@android:color/system_neutral1_10</item>
        <item name="colorBackgroundCard">@android:color/system_neutral2_100</item>
        <item name="colorText">@android:color/system_accent1_800</item>
        <item name="colorTextHint">@android:color/system_neutral2_700</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PreuSync.MaterialAlertDialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="materialCardViewStyle">@style/Widget.PreuSync.CardView</item>
    </style>
    <!--Tema por defecto (puedes elegir dinámico o estático, yo pondré dinámico si está disponible)-->
    <style name="AppTheme" parent="Theme.PreuSync.Dynamic">
    </style>
    <!--Pantalla completa-->
    <style name="AppTheme.FullScreen" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <!--Overlays y otros-->
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3">
    </style>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3">
        <item name="android:textColor">?attr/colorText</item>
        <item name="android:popupBackground">@drawable/bg_menu_popup</item>
    </style>
    <style name="AppTheme.Debug" parent="AppTheme">
    </style>
    <!--Tema del splash screen-->
    <style name="Theme.AppSplash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/colorBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">1500</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>
    <!--Tema para los diálogos Material (usará colorAccent en los botones)-->
    <style name="ThemeOverlay.PreuSync.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">?attr/colorAccent</item>
        <item name="colorSecondary">?attr/colorAccent</item>
    </style>
</resources>


