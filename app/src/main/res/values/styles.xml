<resources>
    <!-- Estilo para iconos de marca -->
    <style name="ImageViewIconStyle">
        <item name="tint">?attr/colorAccent</item>
    </style>

    <!-- Estilos base unificados -->
    <style name="Widget.PreuSync" parent="" />

    <style name="Widget.PreuSync.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">?attr/colorBackgroundCard</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="TextAppearance.PreuSync.HeaderTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorAccent</item>
    </style>

    <!-- Estilo para el FAB extendido -->
    <style name="Base.Widget.Material3.ExtendedFloatingActionButton" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="android:textAppearance">?textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorText</item>
        <item name="backgroundTint">?attr/colorSecondary</item>
    </style>

    <!-- Estilo para el Selector de Login/Register -->
    <style name="Widget.PreuSync.ButtonToggleGroup">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="singleSelection">true</item>
        <item name="selectionRequired">true</item>
    </style>

    <!-- Estilo para botones globales -->
    <style name="Widget.PreuSync.Button.Global" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorSecondary</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
        <item name="cornerRadius">@dimen/button_corner_radius_normal</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
    </style>

    <!-- Estilo para campos de texto unificado -->
    <style name="Widget.PreuSync.TextInputLayout.OutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/textinputlayout_tint</item>
        <item name="hintTextColor">@color/textinputlayout_tint</item>
        <item name="startIconTint">@color/textinputlayout_tint</item>
        <item name="endIconTint">@color/textinputlayout_tint</item>
        <item name="shapeAppearance">@style/Widget.PreuSync.TextInputLayout.ShapeAppearance</item>
    </style>

    <style name="Widget.PreuSync.TextInputLayout.ShapeAppearance" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Estilo para selectores desplegables -->
    <style name="Widget.PreuSync.TextInputLayout.OutlinedBox.ExposedDropdownMenu" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/textinputlayout_tint</item>
        <item name="hintTextColor">@color/textinputlayout_tint</item>
        <item name="startIconTint">@color/textinputlayout_tint</item>
        <item name="endIconTint">@color/textinputlayout_tint</item>
        <item name="shapeAppearance">@style/Widget.PreuSync.TextInputLayout.ShapeAppearance</item>
    </style>

    <!-- Indicador de Navegación -->
    <style name="BottomNavigationView.ActiveIndicator" parent="">
        <item name="android:color">?attr/colorControlNormal</item>
    </style>

    <!-- Otros estilos auxiliares -->
    <style name="PopupMenuStyle" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_menu_popup</item>
        <item name="android:textColor">?attr/colorText</item>
    </style>

    <!-- Temas para familias tipográficas -->
    <style name="Theme.PreuSync.Static.Sans" parent="Theme.PreuSync.Static">
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Theme.PreuSync.Static.Serif" parent="Theme.PreuSync.Static">
        <item name="android:fontFamily">serif</item>
    </style>
    <style name="Theme.PreuSync.Static.Mono" parent="Theme.PreuSync.Static">
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="Theme.PreuSync.Dynamic.Sans" parent="Theme.PreuSync.Dynamic">
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Theme.PreuSync.Dynamic.Serif" parent="Theme.PreuSync.Dynamic">
        <item name="android:fontFamily">serif</item>
    </style>
    <style name="Theme.PreuSync.Dynamic.Mono" parent="Theme.PreuSync.Dynamic">
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>
