<!--
    ============================================================================
    item_empty_events.xml
    ============================================================================

    📌 ESTADO VACÍO PARA EVENTOS (TYPE_EMPTY)
    ============================================================================

    Este layout se muestra cuando no hay eventos disponibles.
    Se usa en SchoolEventsFragment y ExternalEventsFragment.

    🔥 NOTA: Este layout se muestra como un ítem más del RecyclerView,
    lo que permite que el RecyclerView siempre esté visible y pueda
    consumir eventos táctiles, evitando interferencias con el ViewPager.

    ============================================================================
-->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/padding_32dp"
    android:minHeight="200dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_empty_events"
        android:contentDescription="@string/message_empty_events" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_16dp"
        android:text="@string/message_empty_events"
        android:textSize="@dimen/text_size_16sp"
        android:textColor="?attr/colorTextHint"
        android:gravity="center"
        tools:text="No hay eventos" />

</LinearLayout>


