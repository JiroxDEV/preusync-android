<!--
    ============================================================================
    item_profile_header.xml
    ============================================================================

    📌 HEADER DEL PERFIL (TYPE_PROFILE_HEADER)
    ============================================================================

    Este layout representa la cabecera del perfil de usuario dentro del RecyclerView.
    Contiene:
      - Avatar (inicial o imagen de rol)
      - Nombre y apellidos
      - Nombre de usuario
      - Rol (traducido)
      - Información adicional según el rol (escuela, grupo, tutor, etc.)
      - Número de identidad
      - Estado de verificación (icono)
      - Accesso a la edición del avatar (click en el avatar)

    🔥 NOTA: Este layout reemplaza el CardView que antes estaba dentro del NestedScrollView.
    Ahora es un ítem más del RecyclerView, lo que elimina el conflicto de scroll anidado.

    ============================================================================
-->

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.PreuSync.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/padding_8dp"
    android:layout_marginEnd="@dimen/padding_8dp"
    android:layout_marginTop="@dimen/padding_8dp"
    android:layout_marginBottom="@dimen/padding_8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_16dp">

        <!-- Contenido principal del perfil -->
        <LinearLayout
            android:id="@+id/profileContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Fila: Avatar + Nombre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Avatar -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAvatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    app:cardCornerRadius="36dp"
                    app:cardBackgroundColor="?attr/colorAccent"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="visible"
                    app:strokeWidth="0dp">

                    <!-- Texto de inicial (cuando el avatar es una inicial) -->
                    <TextView
                        android:id="@+id/initialAvatarText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="@dimen/text_size_32sp"
                        android:textColor="?attr/colorBackground"
                        android:visibility="gone"
                        tools:text="U" />

                    <!-- Imagen de rol (cuando el avatar es un icono de rol) -->
                    <ImageView
                        android:id="@+id/roleAvatarImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/padding_14dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:src="@drawable/ic_school"
                        android:contentDescription="@string/hint_role" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Nombre y apellidos -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/padding_16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/firstNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorText"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Usuario" />

                    <TextView
                        android:id="@+id/lastNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/padding_2dp"
                        android:textSize="@dimen/text_size_18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorText"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Prueba" />
                </LinearLayout>
            </LinearLayout>

            <!-- Username -->
            <TextView
                android:id="@+id/usernameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_8dp"
                android:textSize="@dimen/text_size_14sp"
                android:textColor="?attr/colorAccent"
                tools:text="@string/hint_username" />

            <!-- Rol -->
            <TextView
                android:id="@+id/roleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_2dp"
                android:textSize="@dimen/text_size_14sp"
                android:textColor="?attr/colorTextHint"
                tools:text="@string/hint_role" />

            <!-- Información adicional del rol (escuela, grupo, tutor, responsabilidades) -->
            <TextView
                android:id="@+id/roleInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_12dp"
                android:textSize="@dimen/text_size_14sp"
                android:textColor="?attr/colorTextHint"
                android:visibility="gone"
                tools:text="@string/profile_school_label" />

            <!-- Carnet de identidad -->
            <TextView
                android:id="@+id/idText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_elevation"
                android:textSize="@dimen/text_size_14sp"
                android:textColor="?attr/colorTextHint"
                android:visibility="gone"
                tools:text="@string/label_id" />

        </LinearLayout>

        <!-- Ícono de estado (verificado, pendiente, baneado) -->
        <ImageView
            android:id="@+id/statusImage"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_verified"
            app:tint="?attr/colorAccent"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/card_elevation"
            android:contentDescription="@string/label_verified" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>


