<!--
    ============================================================================
    item_error_posts.xml
    ============================================================================

    📌 ESTADO DE ERROR (TYPE_ERROR)
    ============================================================================

    Este layout se muestra cuando falla la carga de posts del usuario.
    Proporciona un mensaje de error y un botón para reintentar la carga.

    🔥 NOTA: Este ítem aparece cuando:
        - La carga de posts falla por problemas de red.
        - El token de autenticación ha expirado.
        - El servidor devuelve un error.

    El botón "Reintentar" permite al usuario volver a intentar la carga
    sin necesidad de hacer pull-to-refresh.

    ============================================================================
-->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/padding_32dp">

    <!-- Icono de error -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_error_posts"
        android:contentDescription="@string/error_loading_data" />

    <!-- Mensaje de error -->
    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_16dp"
        android:text="@string/error_loading_data"
        android:textSize="@dimen/text_size_16sp"
        android:textColor="?attr/colorTextHint"
        android:gravity="center"
        tools:text="Error al cargar los posts" />

    <!-- Botón Reintentar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/retryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_16dp"
        android:text="@string/button_retry"
        style="@style/Widget.PreuSync.Button.Global" />

</LinearLayout>


