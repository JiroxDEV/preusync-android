<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    android:padding="16dp">

    <TextView
        android:id="@+id/termsTitle"
        style="@style/TextAppearance.PreuSync.HeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_terms_and_conditions"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:textSize="28sp" />

    <!-- El TextView será reemplazado dinámicamente por un WebView -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/termsTextView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/label_loading" />

        <ProgressBar
            android:id="@+id/termsProgressBar"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <CheckBox
        android:id="@+id/checkbox1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/onboarding_accept_terms"
        android:textStyle="bold"
        android:textColor="?attr/colorText"
        android:textSize="16sp" />

</LinearLayout>
