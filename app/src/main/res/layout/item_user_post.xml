<!--
    ============================================================================
    item_user_post.xml
    ============================================================================

    📌 ÍTEM DE POST DEL USUARIO (TYPE_POST_ITEM)
    ============================================================================

    Este layout representa cada post individual del usuario dentro de la lista
    de "Mis posts". Se muestra como una tarjeta con:
      - Imagen del post (si tiene)
      - Título del post
      - Fecha de creación
      - Número de "Me gusta" y "No me gusta"

    🔥 MEJORAS PARA PREVENIR SALTO DE SCROLL:
      1. Se elimina el OnTouchListener que desactivaba SwipeRefreshLayout
         (causaba conflictos con el scroll).
      2. Se mantiene android:foreground="?attr/selectableItemBackground"
         para el efecto ripple al tocar.
      3. Se desactiva el foco en todos los elementos hijos.
      4. El click se maneja a través del OnClickListener del itemView
         (no a través de CardView directamente).

    📦 NOTA: Este layout es reutilizado por el ProfileAdapter y también podría
    usarse en otros lugares de la app.

    ============================================================================
-->

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.PreuSync.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/padding_8dp"
    android:layout_marginEnd="@dimen/padding_8dp"
    android:layout_marginTop="@dimen/card_elevation"
    android:layout_marginBottom="@dimen/card_elevation"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <!-- Contenedor principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/padding_12dp"
        android:focusable="false"
        android:focusableInTouchMode="false">

        <!-- Imagen del post (thumbnail) -->
        <ImageView
            android:id="@+id/userPostImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_image_broken"
            android:contentDescription="@string/description_event_image"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <!-- Contenido del post (título, fecha, estadísticas) -->
        <LinearLayout
            android:id="@+id/userPostTextContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/padding_12dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <!-- Título -->
            <TextView
                android:id="@+id/userPostTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorText"
                android:maxLines="2"
                android:ellipsize="end"
                android:focusable="false"
                android:focusableInTouchMode="false" />

            <!-- Fecha -->
            <TextView
                android:id="@+id/userPostDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_12sp"
                android:textColor="?attr/colorTextHint"
                android:layout_marginTop="@dimen/card_elevation"
                android:focusable="false"
                android:focusableInTouchMode="false" />

            <!-- Estadísticas de votos -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/card_elevation"
                android:focusable="false"
                android:focusableInTouchMode="false">

                <!-- Me gusta -->
                <TextView
                    android:id="@+id/userPostLikes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_14sp"
                    android:textColor="?attr/colorAccent"
                    android:drawableStart="@drawable/ic_like_filled"
                    android:drawablePadding="4dp"
                    android:text="0"
                    android:focusable="false"
                    android:focusableInTouchMode="false" />

                <!-- No me gusta -->
                <TextView
                    android:id="@+id/userPostDislikes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_14sp"
                    android:textColor="?attr/colorTextHint"
                    android:drawableStart="@drawable/ic_dislike_filled"
                    android:drawablePadding="4dp"
                    android:layout_marginStart="@dimen/padding_16dp"
                    android:text="0"
                    android:focusable="false"
                    android:focusableInTouchMode="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>


