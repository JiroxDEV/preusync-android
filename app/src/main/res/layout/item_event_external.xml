<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/eventExternalContainer"
    style="@style/Widget.PreuSync.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Imagen Superior -->
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@string/description_event_image" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/text_size_18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorText"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/detailsCardView"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="@dimen/padding_8dp"
                    app:cardBackgroundColor="?attr/colorControlHighlight"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/detailsImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/card_elevation"
                        android:src="@drawable/ic_expand_more"
                        app:tint="?attr/colorAccent" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Metadatos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/padding_8dp">

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawablePadding="6dp"
                    app:drawableTint="?attr/colorAccent"/>

                <TextView
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:drawableStart="@drawable/ic_time"
                    android:drawablePadding="6dp"
                    android:layout_marginTop="@dimen/card_elevation"
                    app:drawableTint="?attr/colorAccent"/>

                <TextView
                    android:id="@+id/place"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:drawableStart="@drawable/ic_place"
                    android:drawablePadding="6dp"
                    android:layout_marginTop="@dimen/card_elevation"
                    app:drawableTint="?attr/colorAccent"/>
            </LinearLayout>

            <TextView
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_14sp"
                android:textColor="?attr/colorText"
                android:layout_marginTop="@dimen/padding_12dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>


