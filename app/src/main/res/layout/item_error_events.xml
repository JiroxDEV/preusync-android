<!--
    ============================================================================
    item_error_events.xml
    ============================================================================

    📌 ESTADO DE ERROR PARA EVENTOS (TYPE_ERROR)
    ============================================================================

    Este layout se muestra cuando falla la carga de eventos.
    Se usa en SchoolEventsFragment y ExternalEventsFragment.

    Contiene:
      - Icono de error
      - Mensaje de error
      - Botón "Reintentar"

    🔥 NOTA: Este layout se muestra como un ítem más del RecyclerView,
    lo que permite que el RecyclerView siempre esté visible y pueda
    consumir eventos táctiles, evitando interferencias con el ViewPager.

    ============================================================================
-->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/padding_32dp"
    android:minHeight="200dp">

    <!-- Icono de error -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_error_events"
        android:contentDescription="@string/error_loading_data" />

    <!-- Mensaje de error -->
    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_16dp"
        android:text="@string/error_loading_data"
        android:textSize="@dimen/text_size_16sp"
        android:textColor="?attr/colorTextHint"
        android:gravity="center"
        tools:text="Error al cargar los eventos" />

    <!-- Botón Reintentar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/retryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_16dp"
        android:text="@string/button_retry"
        style="@style/Widget.PreuSync.Button.Global" />

</LinearLayout>


