<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/aboutLayoutContainer">
    <LinearLayout
        android:id="@+id/actionBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="@dimen/padding_top_21dp"
        android:paddingBottom="@dimen/padding_8dp"
        android:background="?attr/colorBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="@dimen/padding_3dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/ripple_circular"
            style="@style/ImageViewIconStyle" />
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_8dp"
            android:text="@string/title_about"
            android:textSize="@dimen/text_size_25sp"
            android:textStyle="bold"
            android:textColor="?attr/colorAccent"
            android:layout_weight="1" />
        <ImageButton
            android:id="@+id/donateButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="@dimen/padding_3dp"
            android:layout_marginRight="@dimen/padding_2dp"
            android:src="@drawable/ic_donate"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/ripple_circular"
            style="@style/ImageViewIconStyle" />
        <ImageButton
            android:id="@+id/helpButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="@dimen/padding_3dp"
            android:layout_marginLeft="@dimen/padding_2dp"
            android:src="@drawable/ic_help"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/ripple_circular"
            style="@style/ImageViewIconStyle" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="8dp"
        android:paddingBottom="@dimen/padding_bottom_50dp"
        android:background="?attr/colorBackground"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <RelativeLayout
            android:id="@+id/relativeLayoutContainer"
            android:layout_width="match_parent"
            android:layout_height="240dp">
            <ImageView
                android:id="@+id/logoImage"
                style="@style/ImageViewIconStyle"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:src="@drawable/logo"
                android:scaleType="centerCrop"
                android:layout_centerInParent="true" />
            <TextView
                android:id="@+id/nameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding_8dp"
                android:text="@string/app_name"
                android:textStyle="bold"
                android:textColor="?attr/colorAccent"
                android:layout_alignBottom="@id/logoImage"
                android:layout_centerHorizontal="true"
                android:textSize="@dimen/text_size_30sp" />
            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0"
                android:textSize="@dimen/text_size_14sp"
                android:textColor="?attr/colorTextHint"
                android:translationY="2.0dp"
                android:layout_alignBottom="@id/nameText"
                android:layout_centerHorizontal="true" />
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/aboutContentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal|bottom"
            android:orientation="vertical"
            android:layout_gravity="bottom"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <LinearLayout
                android:id="@+id/updateCheckLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_weight="1">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateCheckButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_8dp"
                    android:gravity="center_horizontal|center_vertical"
                    android:text="@string/button_check_updates"
                    android:textSize="@dimen/text_size_12sp"
                    android:textColor="#FFFFFF"
                    style="@style/Widget.PreuSync.Button.Global" />
            </LinearLayout>
            <ImageView
                android:id="@+id/authorLogo"
                style="@style/ImageViewIconStyle"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_branding"
                android:scaleType="center"
                android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true" />
            <LinearLayout
                android:id="@+id/socialButtonsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_5dp"
                android:gravity="center_horizontal|center_vertical"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/whatsappButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="@dimen/padding_2dp"
                    android:padding="@dimen/padding_3dp"
                    android:src="@drawable/ic_whatsapp"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/ripple_circular"
                    style="@style/ImageViewIconStyle" />
                <ImageView
                    android:id="@+id/facebookButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="@dimen/padding_2dp"
                    android:padding="@dimen/padding_3dp"
                    android:src="@drawable/ic_facebook"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/ripple_circular"
                    style="@style/ImageViewIconStyle" />
                <ImageView
                    android:id="@+id/telegramButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="@dimen/padding_2dp"
                    android:padding="@dimen/padding_3dp"
                    android:src="@drawable/ic_telegram"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/ripple_circular"
                    style="@style/ImageViewIconStyle" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>


