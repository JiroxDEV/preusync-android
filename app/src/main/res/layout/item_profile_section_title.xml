<!--
    ============================================================================
    item_profile_section_title.xml
    ============================================================================

    📌 TÍTULO DE SECCIÓN "MIS POSTS" (TYPE_SECTION_TITLE)
    ============================================================================

    Este layout es un título simple que aparece antes de la lista de posts
    del usuario. Sirve como separador visual entre las estadísticas y los posts.

    🔥 NOTA: Este es un ítem más del RecyclerView. Al ser parte del RecyclerView,
    el scroll es uniforme y sin saltos.

    ============================================================================
-->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/padding_16dp"
    android:paddingEnd="@dimen/padding_16dp"
    android:paddingTop="@dimen/padding_12dp"
    android:paddingBottom="@dimen/padding_8dp">

    <TextView
        android:id="@+id/sectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_title_myposts"
        android:textSize="@dimen/text_size_18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorAccent"
        tools:text="Mis posts" />

</LinearLayout>


