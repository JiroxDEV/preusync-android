<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_24dp"
        android:gravity="center_horizontal">

        <TextView
            style="@style/TextAppearance.PreuSync.HeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_title_welcome_red"
            android:textSize="28sp"
            android:layout_marginBottom="32dp" />

        <!-- Feature 1: Comunidad -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PreuSync.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_16dp"
            app:cardCornerRadius="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_nav_posts"
                    app:tint="?attr/colorAccent"
                    android:contentDescription="@string/onboarding_feature_community_title" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/padding_16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_feature_community_title"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="?attr/colorText" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_feature_community_desc"
                        android:textSize="14sp"
                        android:textColor="?attr/colorTextHint" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Feature 2: Gestión Académica -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PreuSync.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_16dp"
            app:cardCornerRadius="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_assignment"
                    app:tint="?attr/colorAccent"
                    android:contentDescription="@string/onboarding_feature_schedule_title" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/padding_16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_feature_schedule_title"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="?attr/colorText" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_feature_schedule_desc"
                        android:textSize="14sp"
                        android:textColor="?attr/colorTextHint" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Feature 3: Seguridad -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PreuSync.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_16dp"
            app:cardCornerRadius="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_verified"
                    app:tint="?attr/colorAccent"
                    android:contentDescription="@string/onboarding_feature_security_title" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/padding_16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_feature_security_title"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="?attr/colorText" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_feature_security_desc"
                        android:textSize="14sp"
                        android:textColor="?attr/colorTextHint" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_24dp"
            android:text="@string/onboarding_desc_2"
            android:textSize="16sp"
            android:textStyle="bold|italic"
            android:textColor="?attr/colorAccent"
            android:gravity="center" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
