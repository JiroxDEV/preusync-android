        <item name="colorText">@android:color/system_accent2_100</item>
        <item name="colorTextHint">@android:color/system_accent1_100</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PreuSync.MaterialAlertDialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="materialCardViewStyle">@style/Widget.PreuSync.CardView</item>
    </style>
